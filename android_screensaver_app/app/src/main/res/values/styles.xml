<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PosScreensaver" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0E17</item>
        <item name="android:navigationBarColor">#0A0E17</item>
    </style>

    <style name="Theme.FullScreenAd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
