<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video Ad View via Media3 ExoPlayer: texture_view avoids any Rockchip VOP2 DRM display plane conflicts -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/adPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        android:visibility="gone" />

    <!-- Image Ad View: centerCrop fills 100% of the screen with zero black bars -->
    <ImageView
        android:id="@+id/adImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <!-- Floating Elegant Touch-to-Start Capsule (Zero black screens/bars) -->
    <LinearLayout
        android:id="@+id/touchPromptBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_touch_badge"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_touch_prompt"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المس الشاشة للبدء"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TOUCH SCREEN TO START"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
