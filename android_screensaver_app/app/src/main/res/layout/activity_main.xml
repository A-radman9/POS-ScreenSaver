<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POS Ad Screensaver"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Automatic 2-Minute Inactivity Screensaver"
            android:textColor="#FF9800"
            android:textSize="13sp" />

        <!-- Status & Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#161C28"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking permissions..."
                android:textColor="#ECEFF1"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvMediaCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ads in /sdcard/Ads/: 0 files detected"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Barcode Scanner Watcher: Checking..."
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Permission 1: Overlay -->
            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FF6B00"
                android:text="1. Grant 'Display Over Other Apps'"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Permission 2: All Files Access -->
            <Button
                android:id="@+id/btnStoragePermission"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FF9800"
                android:text="2. Grant 'All Files Access' for /sdcard/Ads/"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Permission 3: Barcode Scanner Watcher (Optional) -->
            <Button
                android:id="@+id/btnAccessibilityPermission"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#6366F1"
                android:text="3. Enable Barcode Scanner Watcher"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#161C28"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Big Start Button -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#10B981"
                android:text="▶ Start Inactivity Monitor (Opens POS)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp" />

            <!-- Test Button -->
            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#3B82F6"
                android:text="Test Ad (Dismisses Back to Previous Screen)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Instructions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#161C28"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 Where to Place Your Ads:"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Copy your images (.jpg, .png) and videos (.mp4) into this exact folder on the device or USB:\n/sdcard/Ads/"
                android:textColor="#FFB74D"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="⏱️ How it Works:"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• Fixed 2-minute timer: Ads only appear when no one touches the screen or scans barcodes for 2 full minutes.\n• When the customer touches the screen, the ad disappears instantly and returns to your POS app."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
